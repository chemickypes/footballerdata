# footballerdata — environment configuration (copy to .env and fill in)

# ── Local LLM (Ollama) — primary engine of the "Analista" copilot ──
# Address and port of your Ollama server (with or without /v1 suffix).
LLM_BASE_URL=http://localhost:11434
# Local model tag.
LLM_MODEL=gemma4:e4b
# Read-timeout in seconds. Non-streaming replies arrive only at the end of
# generation: keep generous on CPU-only inference.
LLM_TIMEOUT=300
# Reasoning control for reasoning models (gemma4:e4b thinks by default and the
# hidden trace eats into the token budget, truncating the answer):
# off (default) = disable thinking | low / minimal / medium / high = cap effort
# default = let the model decide
LLM_REASONING_EFFORT=off
# Optional context-window override (tokens). Leave commented for model default.
# LLM_NUM_CTX=4096

# ── Optional cloud fallbacks (cascade: local -> Groq -> Gemini -> OpenAI) ──
# GROQ_API_KEY=
# GEMINI_API_KEY=
# LLM_API_KEY=

# ── Bot persona overrides ──
# BOT_NAME=Analista
# BOT_SUBTITLE=Assistente Analitico Quantitativo
# BOT_SYSTEM_PROMPT=

# ── Dynamic live feed (optional) ──
# API_FOOTBALL_KEY=
